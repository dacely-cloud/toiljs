{
    "name": "toiljs",
    "type": "module",
    "version": "0.0.117",
    "author": "Dacely",
    "description": "The modern React framework: a file-based React frontend and a ToilScript-compiled WebAssembly backend.",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/dacely-cloud/toiljs.git"
    },
    "bugs": {
        "url": "https://github.com/dacely-cloud/toiljs/issues"
    },
    "engines": {
        "node": ">=24.0.0"
    },
    "exports": {
        ".": {
            "types": "./build/client/index.d.ts",
            "import": "./build/client/index.js",
            "default": "./build/client/index.js"
        },
        "./client": {
            "types": "./build/client/index.d.ts",
            "import": "./build/client/index.js",
            "default": "./build/client/index.js"
        },
        "./compiler": {
            "types": "./build/compiler/index.d.ts",
            "import": "./build/compiler/index.js",
            "default": "./build/compiler/index.js"
        },
        "./logger": {
            "types": "./build/logger/index.d.ts",
            "import": "./build/logger/index.js",
            "default": "./build/logger/index.js"
        },
        "./shared": {
            "types": "./build/shared/index.d.ts",
            "import": "./build/shared/index.js",
            "default": "./build/shared/index.js"
        },
        "./backend": {
            "types": "./build/backend/index.d.ts",
            "import": "./build/backend/index.js",
            "default": "./build/backend/index.js"
        },
        "./devserver": {
            "types": "./build/devserver/index.d.ts",
            "import": "./build/devserver/index.js",
            "default": "./build/devserver/index.js"
        },
        "./io": {
            "types": "./build/io/index.d.ts",
            "import": "./build/io/index.js",
            "default": "./build/io/index.js"
        },
        "./server/runtime": {
            "types": "./server/runtime/index.ts",
            "default": "./server/runtime/index.ts"
        },
        "./server/runtime/exports": {
            "types": "./server/runtime/exports/index.ts",
            "default": "./server/runtime/exports/index.ts"
        },
        "./server/runtime/*": {
            "types": "./server/runtime/*.ts",
            "default": "./server/runtime/*.ts"
        },
        "./server/auth": {
            "types": "./server/auth/index.ts",
            "default": "./server/auth/index.ts"
        },
        "./tsconfig": "./presets/tsconfig.json",
        "./prettier": "./presets/prettier.json",
        "./prettier-plugin": "./presets/prettier-plugin.js",
        "./oxlint": {
            "types": "./presets/oxlint.d.ts",
            "default": "./presets/oxlint.js"
        }
    },
    "bin": {
        "toiljs": "./build/cli/index.js"
    },
    "homepage": "https://toil.org",
    "keywords": [
        "toil",
        "toiljs",
        "typescript",
        "react",
        "webassembly",
        "framework"
    ],
    "license": "Apache-2.0",
    "main": "build/client/index.js",
    "types": "build/client/index.d.ts",
    "typings": "build/client/index.d.ts",
    "module": "build/client/index.js",
    "publishConfig": {
        "access": "public",
        "tag": "latest"
    },
    "scripts": {
        "watch": "tsc -p tsconfig.json --watch",
        "prepublishOnly": "npm run build",
        "gen:docs": "node scripts/gen-toil-docs.mjs",
        "build": "npm run build:shared && npm run build:logger && npm run build:io && npm run build:client && npm run build:backend && npm run build:devserver && npm run build:compiler && npm run build:cli",
        "build:shared": "tsc -p tsconfig.shared.json",
        "build:logger": "tsc -p tsconfig.logger.json",
        "build:client": "tsc -p tsconfig.client.json",
        "build:io": "tsc -p tsconfig.io.json",
        "build:backend": "tsc -p tsconfig.backend.json",
        "build:devserver": "tsc -p tsconfig.devserver.json",
        "build:compiler": "npm run gen:docs && tsc -p tsconfig.compiler.json",
        "build:cli": "tsc -p tsconfig.cli.json --noEmit && esbuild src/cli/index.ts --bundle --platform=node --format=esm --outfile=build/cli/index.js --external:toiljs/*",
        "test": "vitest run --coverage",
        "test:watch": "vitest",
        "test:ui": "vitest --ui",
        "test:coverage": "vitest run --coverage",
        "test:all": "npm run test",
        "prelint": "npm run gen:docs",
        "lint": "oxlint --type-aware src",
        "docs": "npm run build && node scripts/gen-api-docs.mjs",
        "setup": "npm i && npm run build",
        "typecheck": "tsc --noEmit -p tsconfig.json"
    },
    "dependencies": {
        "@dacely/hyper-express": "^6.17.4",
        "@dacely/noble-post-quantum": "^0.6.1",
        "@dacely/toilscript-loader": "^0.1.0",
        "@noble/curves": "^2.4.0",
        "@stylistic/eslint-plugin": "^5.10.0",
        "@vitejs/plugin-react": "^6.1.1",
        "eslint-plugin-react-hooks": "^7.1.1",
        "hash-wasm": "^4.12.0",
        "juice": "^12.1.3",
        "nodemailer": "^10.0.10",
        "oxc-parser": "^0.150.0",
        "oxlint": "^1.83.0",
        "oxlint-tsgolint": "^7.0.2001",
        "picocolors": "^1.1.1",
        "semver": "^7.8.5",
        "sharp": "^0.35.4",
        "toilscript": ">=0.1.60",
        "vite": "^8.3.0",
        "vite-imagetools": "^12.0.1",
        "vite-plugin-node-polyfills": "^0.28.0"
    },
    "peerDependencies": {
        "prettier": ">=3.0.0",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "toilscript": ">=0.1.60",
        "typescript": ">=7.0.2 <8.0.0"
    },
    "overrides": {
        "elliptic": "file:./stubs/elliptic"
    },
    "devDependencies": {
        "@babel/core": "^8.0.5",
        "@babel/preset-env": "^8.0.5",
        "@babel/preset-typescript": "^8.0.1",
        "@clack/prompts": "^1.8.1",
        "@testing-library/dom": "^10.4.2",
        "@testing-library/react": "^16.3.3",
        "@types/node": "^26.5.1",
        "@types/nodemailer": "^8.0.1",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@types/semver": "^7.8.0",
        "@vitest/coverage-v8": "^5.0.0",
        "@vitest/ui": "^5.0.0",
        "esbuild": "^0.28.2",
        "jsdom": "^30.0.1",
        "micromatch": "^4.0.8",
        "prettier": "^3.9.6",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "typescript": "^7.0.2",
        "vitest": "^5.0.0"
    }
}
